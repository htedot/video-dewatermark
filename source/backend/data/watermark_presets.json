{
  "name": "watermark_presets",
  "version": 1,
  "description": "静态水印/台标的位置与尺寸先验 + 多帧投票规则。规则先行，LLM 只做复核取舍。",
  "zones": {
    "top_corner": 0.95,
    "bottom_corner": 0.9,
    "top_edge": 0.8,
    "bottom_edge": 0.72,
    "side_edge": 0.66,
    "center": 0.35
  },
  "weights": {
    "appear_rate": 0.34,
    "stability": 0.2,
    "edge_strength": 0.16,
    "position": 0.2,
    "contrast": 0.1
  },
  "rules": {
    "seed_canny_low": 40,
    "seed_canny_high": 120,
    "close_kernel": 9,
    "dilate_kernel": 5,
    "min_area_ratio": 0.00008,
    "max_area_ratio": 0.25,
    "min_side_px": 6,
    "min_fill_ratio": 0.06,
    "tstd_norm": 24.0,
    "grad_norm": 60.0,
    "contrast_norm": 30.0
  },
  "kinds": {
    "logo": "台标 / 角标（四角，四周有留白，尺寸稳定）",
    "text": "文字水印（长条形，横竖笔画高度接近）",
    "badge": "小图标 / 二维码式角标",
    "unknown": "无法归类（保守起见仍按水印处理）"
  },
  "select_policy": {
    "min_confidence": 0.45,
    "max_regions": 6,
    "always_keep_top": 1,
    "notes": "置信度不足 min_confidence 的候选默认丢弃；LLM 复核只能在这些候选里挑，不能新增。"
  }
}