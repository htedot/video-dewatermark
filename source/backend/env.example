# 复制为 backend/.env 后按需修改；留空即规则模式（无需联网）
PORT=8231
HOST=127.0.0.1

# 可选：接上大模型后启用「参数建议 / 人眼评语」三个触点
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=90
LLM_MAX_TOKENS=1400

# 检测
DETECT_SAMPLE_FRAMES=48
DETECT_WORK_WIDTH=960
DETECT_APPEAR_RATE=0.70
DETECT_MIN_CONF=0.45

# 遮罩 / 修复
MASK_FEATHER_SIGMA=7
MASK_ATTENUATION_RATIO=0.85
INPAINT_RADIUS=5
VIDEO_CRF=18

# 质检
QUALITY_VAR_RATIO=0.30
QUALITY_EDGE_RATIO=0.85
REVIEW_FRAMES=5
MAX_FEEDBACK=2

# 上传上限（MB）
MAX_UPLOAD_MB=512